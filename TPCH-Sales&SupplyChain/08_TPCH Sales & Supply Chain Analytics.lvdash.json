    {
      "name": "21aa2339",
      "displayName": "fact_sales",
      "config": {
        "version": "1.1",
        "source": "tpch.gold.fact_sales",
        "dimensions": [
          {
            "expr": "source.* EXCEPT (net_revenue)"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "net_revenue",
            "expr": "SUM(`source`.`net_price`)",
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT `source`.`order_key`)",
            "displayName": "Total Orders"
          },
          {
            "name": "active_customers",
            "expr": "COUNT(DISTINCT `source`.`customer_key`)",
            "displayName": "Active Customers"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(`source`.`net_price`) / COUNT(DISTINCT `source`.`order_key`)",
            "displayName": "Avg Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_ship_days",
            "expr": "AVG(DATEDIFF(`source`.`receipt_date`, `source`.`ship_date`))",
            "displayName": "Avg Ship-to-Receipt Days"
          }
        ]
      }
    },
    {
